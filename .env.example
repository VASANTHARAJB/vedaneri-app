# ---- General ----
NODE_ENV=development

# ---- MySQL (used by docker-compose and the API/worker) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vedaneri
DB_USER=vedaneri_app
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ---- API ----
API_PORT=4000
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_DOMAIN=localhost

# ---- First CMS admin (used once by: npm run db:seed) ----
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_NAME=Site Admin
SEED_ADMIN_PASSWORD=change-me-now

# ---- Frontends ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000/api/v1

# ---- Payments (Razorpay): fill when the trust gives the keys ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WhatsApp Business (worker): fill after Meta approval ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- Object storage (S3 compatible): fill for production uploads ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Python worker ----
WORKER_PORT=8000
VITE_SITE_URL=http://localhost:3000
