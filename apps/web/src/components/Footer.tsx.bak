import Link from 'next/link';
import type { Locale } from '@/lib/i18n';
import type { Dictionary } from '@/lib/dictionary';
import { SITE } from '@/lib/site';

type Props = { locale: Locale; siteName: string; fullName: string; t: Dictionary['footer'] };

const linkClass = 'text-white/85 underline-offset-4 transition-colors hover:text-white hover:underline hover:decoration-saffron hover:decoration-2';

export default function Footer({ locale, siteName, fullName, t }: Props) {
  const year = new Date().getFullYear();
  return (
    <footer className="bg-charcoal text-white">
      <div aria-hidden="true" className="h-1 bg-saffron" />
      <div className="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
        <div>
          <p className="brand-name font-serif text-3xl font-bold text-white">{siteName}</p>
          <p className="mt-1 text-white/85">{fullName}</p>
          <p className="mt-4 font-display text-xl italic text-rose">{t.tagline}</p>
        </div>

        <nav aria-label={t.linksTitle}>
          <h2 className="font-serif text-lg font-bold text-white">{t.linksTitle}</h2>
          <ul className="mt-4 space-y-2.5 text-[0.97rem]">
            {t.links.map((l) => (
              <li key={l.href}><Link href={`/${locale}${l.href}`} className={linkClass}>{l.label}</Link></li>
            ))}
          </ul>
        </nav>

        <div>
          <h2 className="font-serif text-lg font-bold text-white">{t.trustsTitle}</h2>
          <ul className="mt-4 space-y-4 text-[0.97rem]">
            {t.trusts.map((x) => (
              <li key={x.name}>
                <p className="font-semibold uppercase tracking-wide text-white">{x.name}</p>
                <p className="text-sm text-white/75">{x.reg}</p>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 className="font-serif text-lg font-bold text-white">{t.contactTitle}</h2>
          <p className="mt-4 text-[0.97rem] text-white/85">{t.address}</p>
          <ul className="mt-3 space-y-2.5 text-[0.97rem]">
            {SITE.phones.map((p) => (
              <li key={p}><a href={`tel:${p.replace(/\s/g, '')}`} className={linkClass}>{p}</a></li>
            ))}
            {SITE.email && <li><a href={`mailto:${SITE.email}`} className={linkClass}>{SITE.email}</a></li>}
          </ul>
          <div className="mt-5 flex gap-3">
            {SITE.youtube && (
              <a href={SITE.youtube} aria-label={t.youtube} target="_blank" rel="noopener noreferrer"
                className="flex h-10 w-10 items-center justify-center rounded-full border border-white/50 transition-colors hover:border-saffron hover:bg-saffron hover:text-charcoal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5 3-5 3z" /></svg>
              </a>
            )}
            {SITE.whatsapp && (
              <a href={SITE.whatsapp} aria-label={t.whatsapp} target="_blank" rel="noopener noreferrer"
                className="flex h-10 w-10 items-center justify-center rounded-full border border-white/50 transition-colors hover:border-saffron hover:bg-saffron hover:text-charcoal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M3 21l1.6-4.7A8.5 8.5 0 1 1 8 19.5L3 21z" /><path d="M9 10c0 3 2 5 5 5l1-1.5-2-1-.8.7c-.8-.4-1.5-1.1-1.9-1.9l.7-.8-1-2L9 10z" /></svg>
              </a>
            )}
          </div>
        </div>
      </div>
      <div className="border-t border-white/15">
        <p className="mx-auto max-w-7xl px-4 py-5 text-center text-sm text-white/75 lg:px-8">© {year} {t.rights}</p>
      </div>
    </footer>
  );
}
