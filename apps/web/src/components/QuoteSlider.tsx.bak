'use client';

import { useEffect, useState } from 'react';
import type { Dictionary } from '@/lib/dictionary';

export default function QuoteSlider({ t }: { t: Dictionary['quotes'] }) {
  const [i, setI] = useState(0);
  const [paused, setPaused] = useState(false);
  const count = t.items.length;
  const go = (n: number) => setI((n + count) % count);

  useEffect(() => {
    if (paused || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const id = setInterval(() => setI((c) => (c + 1) % count), 7000);
    return () => clearInterval(id);
  }, [paused, count]);

  return (
    <section aria-label={t.label} className="relative overflow-hidden bg-maroon py-16 text-white sm:py-24"
      onMouseEnter={() => setPaused(true)} onMouseLeave={() => setPaused(false)}
      onFocus={() => setPaused(true)} onBlur={() => setPaused(false)}>
      <div aria-hidden="true" className="pointer-events-none absolute left-1/2 top-1/2 h-[520px] w-[520px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-saffron/20" />
      <div aria-hidden="true" className="pointer-events-none absolute left-1/2 top-1/2 h-[360px] w-[360px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-saffron/20" />

      <div className="relative mx-auto max-w-4xl px-4 text-center">
        <svg aria-hidden="true" width="44" height="44" viewBox="0 0 24 24" fill="currentColor" className="mx-auto text-saffron">
          <path d="M7 7h4v4c0 3-1.5 5-4 6v-2c1-.6 1.5-1.6 1.5-3H7V7zm8 0h4v4c0 3-1.5 5-4 6v-2c1-.6 1.5-1.6 1.5-3H15V7z" />
        </svg>
        <p className="mt-2 text-sm font-semibold uppercase tracking-widest text-rose">{t.label}</p>

        <div aria-live={paused ? 'polite' : 'off'} className="mt-6 min-h-[9rem] sm:min-h-[8rem]">
          <blockquote key={i} className="animate-fade-up font-display text-3xl font-semibold leading-snug text-white motion-reduce:animate-none sm:text-5xl">
            “{t.items[i]}”
          </blockquote>
        </div>

        <div className="mt-8 flex items-center justify-center gap-4">
          <button type="button" onClick={() => go(i - 1)} aria-label={t.prev}
            className="flex h-11 w-11 items-center justify-center rounded-full border border-white/60 transition-colors hover:bg-white hover:text-maroon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
          </button>
          <div className="flex gap-2">
            {t.items.map((_, n) => (
              <button key={n} type="button" onClick={() => setI(n)} aria-label={`${t.goTo} ${n + 1}`} aria-current={n === i ? 'true' : undefined}
                className={`h-2.5 rounded-full transition-all duration-300 ${n === i ? 'w-8 bg-saffron' : 'w-2.5 bg-white/60 hover:bg-white'}`} />
            ))}
          </div>
          <button type="button" onClick={() => go(i + 1)} aria-label={t.next}
            className="flex h-11 w-11 items-center justify-center rounded-full border border-white/60 transition-colors hover:bg-white hover:text-maroon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
          </button>
        </div>
      </div>
    </section>
  );
}
