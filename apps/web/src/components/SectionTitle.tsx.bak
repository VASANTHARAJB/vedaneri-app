type Props = { title: string; subtitle?: string; light?: boolean; id?: string };

// Section heading with the golden ornament used across the site.
export default function SectionTitle({ title, subtitle, light = false, id }: Props) {
  return (
    <div className="mx-auto max-w-2xl text-center">
      <h2 id={id} className={`text-3xl sm:text-4xl ${light ? 'text-white' : 'text-maroon'}`}>{title}</h2>
      <div aria-hidden="true" className="mt-4 flex items-center justify-center gap-3">
        <span className="h-px w-12 bg-saffron" />
        <span className="h-2 w-2 rotate-45 bg-saffron" />
        <span className="h-px w-12 bg-saffron" />
      </div>
      {subtitle && <p className={`mt-4 ${light ? 'text-white/85' : 'text-charcoal/80'}`}>{subtitle}</p>}
    </div>
  );
}
