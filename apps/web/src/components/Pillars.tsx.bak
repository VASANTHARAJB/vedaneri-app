import Link from 'next/link';
import type { Locale } from '@/lib/i18n';
import type { Dictionary } from '@/lib/dictionary';
import type { ReactElement } from 'react';
import Reveal from './Reveal';

type Props = { locale: Locale; t: Dictionary['pillars'] };

const ICONS: Record<string, ReactElement> = {
  // temple
  ashram: <path d="M3 21h18M5 21V10l7-6 7 6v11M9 21v-6h6v6M12 4V2" />,
  // lamp
  sevas: <path d="M12 3c.5 2.2 3 3.6 3 6.2a3 3 0 0 1-6 0c0-1.4.6-2.2 1.2-3 .3.8.7 1.2 1.2 1.4C11.6 6.2 11.8 4.6 12 3zM5 15h14l-2 5H7l-2-5z" />,
  // hands holding heart
  donation: <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" />,
  // open book
  resources: <path d="M12 6c-2-1.5-5-2-8-2v14c3 0 6 .5 8 2 2-1.5 5-2 8-2V4c-3 0-6 .5-8 2zM12 6v14" />,
};

export default function Pillars({ locale, t }: Props) {
  return (
    <section aria-label={t.title} className="relative z-10 -mt-12 pb-6 lg:-mt-16">
      <div className="mx-auto grid max-w-7xl gap-5 px-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6 lg:px-8">
        {t.items.map((item, i) => (
          <Reveal key={item.key} delay={i * 90} className="h-full">
            <Link href={`/${locale}${item.href}`}
              className="group relative flex h-full flex-col overflow-hidden rounded-xl border border-rose bg-white p-6 shadow-[0_12px_32px_-12px_rgba(35,26,24,0.35)] transition duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_40px_-12px_rgba(122,28,28,0.45)]">
              <span aria-hidden="true" className="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-saffron transition-transform duration-500 group-hover:scale-x-100" />
              <span className="flex h-14 w-14 items-center justify-center rounded-full bg-rose text-maroon transition-colors duration-300 group-hover:bg-maroon group-hover:text-white">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  {ICONS[item.key]}
                </svg>
              </span>
              <h3 className="mt-5 text-xl">{item.title}</h3>
              <p className="mt-2 flex-1 text-[0.97rem] text-charcoal/85">{item.text}</p>
              <span className="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-maroon underline decoration-saffron decoration-2 underline-offset-4">
                {t.readMore}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"
                  className="transition-transform duration-300 group-hover:translate-x-1">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </Link>
          </Reveal>
        ))}
      </div>
    </section>
  );
}
