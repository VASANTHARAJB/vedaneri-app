import type { Locale } from '@/lib/i18n';
import type { Dictionary } from '@/lib/dictionary';
import Reveal from './Reveal';
import SectionTitle from './SectionTitle';

type Props = { locale: Locale; t: Dictionary['events'] };

export default function Events({ locale, t }: Props) {
  const tag = locale === 'ta' ? 'ta-IN' : 'en-IN';
  const part = (iso: string, o: Intl.DateTimeFormatOptions) =>
    new Intl.DateTimeFormat(tag, { timeZone: 'UTC', ...o }).format(new Date(iso));
  const full = (iso: string) => part(iso, { day: 'numeric', month: 'long', year: 'numeric' });

  return (
    <section aria-labelledby="events-title" className="bg-rose/60 py-16 sm:py-20">
      <div className="mx-auto max-w-7xl px-4 lg:px-8">
        <SectionTitle id="events-title" title={t.title} />

        <div className="mt-12 grid gap-6 lg:grid-cols-5 lg:gap-8">
          {/* Featured festival */}
          <Reveal className="lg:col-span-2">
            <article className="relative flex h-full flex-col overflow-hidden rounded-2xl bg-maroon p-7 text-white shadow-xl sm:p-9">
              <div aria-hidden="true" className="absolute -right-16 -top-16 h-56 w-56 rounded-full border border-saffron/40" />
              <div aria-hidden="true" className="absolute -right-8 -top-8 h-40 w-40 rounded-full border border-saffron/30" />
              <p className="inline-flex items-center gap-2 self-start rounded-full border border-rose/50 px-3 py-1 text-sm font-semibold text-rose">
                <span className="h-2 w-2 rounded-full bg-saffron motion-safe:animate-pulse" aria-hidden="true" />
                {t.featuredLabel}
              </p>
              <h3 className="relative mt-5 text-3xl text-white sm:text-4xl">{t.featuredTitle}</h3>
              <dl className="relative mt-6 space-y-3 text-white/90">
                <div className="flex items-start gap-3">
                  <svg className="mt-1 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /></svg>
                  <dd><time dateTime={t.featuredStart}>{full(t.featuredStart)}</time> – <time dateTime={t.featuredEnd}>{full(t.featuredEnd)}</time></dd>
                </div>
                <div className="flex items-start gap-3">
                  <svg className="mt-1 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                  <dd>{t.featuredTime}</dd>
                </div>
              </dl>
              <p aria-hidden="true" className="relative mt-auto pt-8 font-display text-7xl font-semibold leading-none text-white/15 sm:text-8xl">
                {part(t.featuredStart, { day: 'numeric' })}–{part(t.featuredEnd, { day: 'numeric' })}
                <span className="mt-2 block text-3xl uppercase tracking-widest text-saffron sm:text-4xl">{part(t.featuredEnd, { month: 'long' })}</span>
              </p>
            </article>
          </Reveal>

          {/* Yearly programs */}
          <Reveal delay={120} className="lg:col-span-3">
            <div className="h-full rounded-2xl border border-rose bg-white p-6 shadow-lg sm:p-8">
              <h3 className="text-2xl">{t.yearlyTitle}</h3>
              <ul className="mt-5 divide-y divide-rose">
                {t.yearly.map((e) => (
                  <li key={e.date} className="flex items-center gap-4 py-3.5">
                    <time dateTime={e.date}
                      className="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-lg bg-rose text-maroon">
                      <span className="text-xl font-bold leading-none">{part(e.date, { day: 'numeric' })}</span>
                      <span className="mt-0.5 text-xs font-semibold uppercase leading-none">{part(e.date, { month: 'short' })}</span>
                    </time>
                    <div className="min-w-0">
                      <p className="font-semibold text-charcoal">{e.name}</p>
                      <p className="text-sm text-charcoal/70">{part(e.date, { year: 'numeric' })}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        </div>
      </div>
    </section>
  );
}
