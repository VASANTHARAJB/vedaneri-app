import Link from 'next/link';
import type { Dictionary } from '@/lib/dictionary';
import type { Locale } from '@/lib/i18n';
import { rupees, sevaPhoto } from '@/lib/format';
import { txt, type Seva } from '@/data/sevas';

function Calendar() {
  return (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" className="shrink-0">
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 10h18M8 3v4M16 3v4" />
    </svg>
  );
}

// One seva in the list. The whole card opens the detail page.
export default function SevaCard({ seva, locale, t }: { seva: Seva; locale: Locale; t: Dictionary['sevas'] }) {
  const name = txt(seva.name, locale);
  const kindLabel = t.filters.find((f) => f.key === seva.kind)?.label ?? '';
  const closed = seva.status !== 'open';
  return (
    <article className="group relative flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-md ring-2 ring-rose transition-shadow focus-within:ring-saffron hover:shadow-xl">
      <div className="relative h-40 overflow-hidden bg-maroon">
        <div className="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style={{ backgroundImage: sevaPhoto(seva.slug) }} role="img" aria-label={name} />
        <span className="absolute left-3 top-3 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-maroon shadow">{kindLabel}</span>
      </div>

      <div className="flex flex-1 flex-col p-5">
        <h3 className="font-display text-2xl font-semibold leading-tight text-maroon [html[lang='ta']_&]:!leading-[1.4] [html[lang='ta']_&]:text-xl">
          <Link href={`/${locale}/sevas/${seva.slug}`} className="after:absolute after:inset-0 focus-visible:outline-none">
            {name}
          </Link>
        </h3>
        <p className="mt-3 flex items-center gap-2 text-sm font-semibold text-charcoal/80">
          <Calendar />
          {txt(seva.when, locale)}
        </p>
        <p className="mt-4 font-display text-4xl font-semibold leading-none text-charcoal">
          {seva.amount > 0 ? rupees(seva.amount) : <span className="text-2xl text-saffron [html[lang='ta']_&]:text-xl">{t.abilityLabel}</span>}
        </p>
        <p className="mt-auto pt-5">
          <span className={`inline-flex w-full items-center justify-center rounded-md px-5 py-3 text-center font-semibold transition-colors ${closed ? 'bg-rose text-charcoal/70' : 'bg-maroon text-white group-hover:bg-charcoal'}`}>
            {closed ? t.closedLabel : t.viewLabel}
          </span>
        </p>
      </div>
    </article>
  );
}
