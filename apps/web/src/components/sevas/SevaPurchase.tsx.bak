'use client';

import { useState } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import type { Dictionary } from '@/lib/dictionary';
import type { Locale } from '@/lib/i18n';
import { WEEKDAYS, formatDate, rupees, todayISO, weekdayOf } from '@/lib/format';
import { dateMode, txt, type Seva } from '@/data/sevas';
import { useCart } from '@/components/cart/CartProvider';

type T = Dictionary['sevas'];

const inputClass =
  'w-full rounded-md border-2 border-rose bg-white px-4 py-2.5 text-charcoal placeholder:text-charcoal/50 focus:border-saffron focus:outline-none disabled:bg-rose/50';

function Field({ id, label, hint, error, children }: { id: string; label: string; hint?: string; error?: string; children: React.ReactNode }) {
  return (
    <div>
      <label htmlFor={id} className="block text-sm font-bold text-charcoal">{label}</label>
      <div className="mt-1">{children}</div>
      {hint && !error && <p id={`${id}-hint`} className="mt-1 text-sm text-charcoal/70">{hint}</p>}
      {error && <p id={`${id}-error`} role="alert" className="mt-1 text-sm font-semibold text-maroon">{error}</p>}
    </div>
  );
}

export default function SevaPurchase({ seva, locale, t }: { seva: Seva; locale: Locale; t: T }) {
  const router = useRouter();
  const { add } = useCart();

  const mode = dateMode(seva);
  const today = todayISO();
  const dayName = seva.weekday !== undefined ? WEEKDAYS[locale][seva.weekday] : '';

  // Earliest and latest date that can be chosen
  const minDate = mode === 'range' && seva.from && seva.from > today ? seva.from : today;
  const maxDate = mode === 'range' ? seva.to : undefined;
  // A one-day or ranged seva whose last date has gone by can no longer be booked
  const past = (mode === 'fixed' || mode === 'range') && !!seva.to && seva.to < today;
  const closed = seva.status !== 'open' || past;

  const [date, setDate] = useState(mode === 'fixed' ? seva.from ?? '' : '');
  const [devotee, setDevotee] = useState('');
  const [gotram, setGotram] = useState('');
  const [nakshatram, setNakshatram] = useState('');
  const [amountStr, setAmountStr] = useState('');
  const [qty, setQty] = useState(1);
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [added, setAdded] = useState(false);

  const choose = seva.amount === 0;
  const unit = choose ? Number(amountStr) || 0 : seva.amount;
  const total = unit * (choose ? 1 : qty);

  const dateHelp =
    mode === 'fixed' ? t.dateFixed.replace('{date}', formatDate(seva.from!, locale))
    : mode === 'range' ? t.dateRange.replace('{from}', formatDate(seva.from!, locale)).replace('{to}', formatDate(seva.to!, locale))
    : mode === 'weekday' ? t.dateWeekday.replaceAll('{day}', dayName)
    : t.dateAny;

  function validate() {
    const e: Record<string, string> = {};
    if (!devotee.trim()) e.devotee = t.errName;
    if (mode !== 'fixed') {
      if (!date) e.date = t.errDate;
      else if (date < today) e.date = t.errDatePast;
      else if (mode === 'range' && (date < (seva.from as string) || date > (seva.to as string))) e.date = t.errDateRange;
      else if (mode === 'weekday' && weekdayOf(date) !== seva.weekday) e.date = t.errDateWeekday.replace('{day}', dayName);
    }
    if (choose && !(Number(amountStr) >= seva.minAmount)) e.amount = t.errAmount.replace('{min}', rupees(seva.minAmount));
    setErrors(e);
    return Object.keys(e).length === 0;
  }

  function addToCart(goToCart: boolean) {
    if (closed || !validate()) return;
    add({ slug: seva.slug, qty: choose ? 1 : qty, unit, date, devotee: devotee.trim(), gotram: gotram.trim(), nakshatram: nakshatram.trim() });
    if (goToCart) router.push(`/${locale}/cart`);
    else setAdded(true);
  }

  if (closed) {
    return (
      <div className="rounded-2xl bg-rose/60 p-6 text-center">
        <p className="font-display text-2xl font-semibold text-maroon">{past ? t.statusPast : t.statusClosed}</p>
        <Link href={`/${locale}/sevas`} className="mt-4 inline-block rounded-md bg-maroon px-5 py-2.5 font-semibold text-white hover:bg-charcoal">{t.backLabel}</Link>
      </div>
    );
  }

  return (
    <form noValidate onSubmit={(e) => { e.preventDefault(); addToCart(false); }} className="rounded-2xl bg-white p-6 shadow-lg ring-2 ring-rose">
      <h2 className="font-display text-2xl font-semibold text-maroon [html[lang='ta']_&]:!leading-[1.4]">{t.formTitle}</h2>

      <div className="mt-5 space-y-4">
        {/* Date */}
        <Field id="seva-date" label={t.dateLabel} hint={dateHelp} error={errors.date}>
          {mode === 'fixed' ? (
            <p className="rounded-md bg-rose/50 px-4 py-2.5 font-semibold text-charcoal">{formatDate(seva.from!, locale)}</p>
          ) : (
            <input id="seva-date" type="date" value={date} min={minDate} max={maxDate} onChange={(e) => setDate(e.target.value)}
              aria-invalid={!!errors.date} aria-describedby={errors.date ? 'seva-date-error' : 'seva-date-hint'} className={inputClass} />
          )}
        </Field>
        {seva.note && <p className="rounded-md bg-saffron/15 px-4 py-2 text-sm font-semibold text-charcoal">{txt(seva.note, locale)}</p>}

        {/* Devotee */}
        <Field id="devotee" label={t.devoteeName} hint={t.devoteeNameHelp} error={errors.devotee}>
          <input id="devotee" value={devotee} onChange={(e) => setDevotee(e.target.value)} autoComplete="off"
            aria-invalid={!!errors.devotee} aria-describedby={errors.devotee ? 'devotee-error' : 'devotee-hint'} className={inputClass} />
        </Field>
        <div className="grid gap-4 sm:grid-cols-2">
          <Field id="gotram" label={`${t.gotram} (${t.optional})`}>
            <input id="gotram" value={gotram} onChange={(e) => setGotram(e.target.value)} className={inputClass} />
          </Field>
          <Field id="nakshatram" label={`${t.nakshatram} (${t.optional})`}>
            <input id="nakshatram" value={nakshatram} onChange={(e) => setNakshatram(e.target.value)} className={inputClass} />
          </Field>
        </div>

        {/* Amount or quantity */}
        {choose ? (
          <Field id="amount" label={t.amountInput} hint={t.amountHelp} error={errors.amount}>
            <div className="relative">
              <span aria-hidden="true" className="absolute left-4 top-1/2 -translate-y-1/2 font-bold text-charcoal/70">₹</span>
              <input id="amount" inputMode="numeric" value={amountStr} onChange={(e) => setAmountStr(e.target.value.replace(/\D/g, ''))}
                aria-invalid={!!errors.amount} aria-describedby={errors.amount ? 'amount-error' : 'amount-hint'} className={`${inputClass} pl-9`} />
            </div>
          </Field>
        ) : (
          <div>
            <p className="text-sm font-bold text-charcoal">{t.qtyLabel}</p>
            <div className="mt-1 inline-flex items-center rounded-md border-2 border-rose">
              <button type="button" aria-label="−" disabled={qty <= 1} onClick={() => setQty((q) => Math.max(1, q - 1))} className="h-11 w-11 text-xl font-bold text-maroon hover:bg-rose disabled:opacity-40">−</button>
              <span aria-live="polite" className="w-12 text-center text-lg font-bold">{qty}</span>
              <button type="button" aria-label="+" disabled={qty >= seva.maxQty} onClick={() => setQty((q) => Math.min(seva.maxQty, q + 1))} className="h-11 w-11 text-xl font-bold text-maroon hover:bg-rose disabled:opacity-40">+</button>
            </div>
          </div>
        )}
      </div>

      <p className="mt-6 flex items-baseline justify-between border-t border-rose pt-4">
        <span className="font-semibold text-charcoal/80">{t.totalLabel}</span>
        <span className="font-display text-3xl font-semibold text-maroon">{rupees(total)}</span>
      </p>

      <div className="mt-4 grid gap-3 sm:grid-cols-2">
        <button type="submit" className="rounded-md border-2 border-maroon px-5 py-3 font-semibold text-maroon transition-colors hover:bg-rose focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron">{t.addToCart}</button>
        <button type="button" onClick={() => addToCart(true)} className="rounded-md bg-maroon px-5 py-3 font-semibold text-white transition-colors hover:bg-charcoal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron">{t.bookNow}</button>
      </div>

      {added && (
        <div role="status" className="mt-4 rounded-md bg-saffron/15 px-4 py-3 text-center">
          <p className="font-semibold text-charcoal">✓ {t.added}</p>
          <p className="mt-2 flex flex-wrap justify-center gap-x-5 gap-y-1">
            <Link href={`/${locale}/cart`} className="font-bold text-maroon underline underline-offset-4">{t.viewCart}</Link>
            <Link href={`/${locale}/sevas`} className="font-bold text-maroon underline underline-offset-4">{t.keepBrowsing}</Link>
          </p>
        </div>
      )}
    </form>
  );
}
