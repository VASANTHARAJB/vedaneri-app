'use client';

import { useEffect, useId, useRef, useState } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import type { Dictionary } from '@/lib/dictionary';
import type { Locale } from '@/lib/i18n';
import { WEEKDAYS, formatDate, rupees, todayISO, weekdayOf } from '@/lib/format';
import { dateMode, txt, type Seva } from '@/data/sevas';
import { GOTRAMS, MAX_FAMILY, NAKSHATRAMS, RASIS, RELATIONS, type FamilyMember } from '@/data/sankalpam';
import { useCart } from '@/components/cart/CartProvider';
import ChoiceField, { fieldClass } from './ChoiceField';

type T = Dictionary['sevas'];
type Member = FamilyMember & { uid: number };

const STORE = 'vedaneri.sankalpam.v1';
type Saved = { devotee: string; gotram: string; rasi: string; nakshatram: string; family: FamilyMember[] };

function readSaved(): Saved | null {
  try {
    const raw = window.localStorage.getItem(STORE);
    return raw ? (JSON.parse(raw) as Saved) : null;
  } catch {
    return null;
  }
}
function writeSaved(v: Saved) {
  try {
    window.localStorage.setItem(STORE, JSON.stringify(v));
  } catch {
    /* ignore: storage can be blocked */
  }
}

// Booking panel in three steps: 1 choose a seva, 2 sankalpam credentials, 3 date selection.
// On the list page the seva comes from the card the visitor picked; on a detail page it is fixed.
export default function SankalpamWizard({
  seva,
  locale,
  t,
  fixed = false,
  onChangeSeva,
}: {
  seva: Seva | null;
  locale: Locale;
  t: T;
  fixed?: boolean;
  onChangeSeva?: () => void;
}) {
  const router = useRouter();
  const { add } = useCart();
  const headingId = useId();
  const headingRef = useRef<HTMLHeadingElement>(null);
  const uid = useRef(0);
  const firstRender = useRef(true);

  const [step, setStep] = useState<1 | 2 | 3>(seva ? 2 : 1);
  const [today, setToday] = useState('');
  const [devotee, setDevotee] = useState('');
  const [gotram, setGotram] = useState('');
  const [rasi, setRasi] = useState('');
  const [nakshatram, setNakshatram] = useState('');
  const [family, setFamily] = useState<Member[]>([]);
  const [date, setDate] = useState(seva && dateMode(seva) === 'fixed' ? seva.from ?? '' : '');
  const [amountStr, setAmountStr] = useState('');
  const [qty, setQty] = useState(1);
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [added, setAdded] = useState<string | null>(null);

  // After the page loads: today's date (kept out of the first render so server and browser match), and the details used last time
  useEffect(() => {
    setToday(todayISO());
    const s = readSaved();
    if (s) {
      setDevotee(s.devotee ?? '');
      setGotram(s.gotram ?? '');
      setRasi(s.rasi ?? '');
      setNakshatram(s.nakshatram ?? '');
      setFamily((s.family ?? []).map((m) => ({ ...m, uid: ++uid.current })));
    }
  }, []);

  // A different seva was picked: start again at step 2 with a clean date and amount
  useEffect(() => {
    setStep(seva ? 2 : 1);
    setErrors({});
    setAmountStr('');
    setQty(1);
    setDate(seva && dateMode(seva) === 'fixed' ? seva.from ?? '' : '');
    if (seva) setAdded(null);
  }, [seva]);

  // Move keyboard and screen-reader focus to the panel heading when the step changes (not on first load)
  useEffect(() => {
    if (firstRender.current) {
      firstRender.current = false;
      return;
    }
    headingRef.current?.focus({ preventScroll: true });
  }, [step, added, seva]);

  const mode = seva ? dateMode(seva) : 'any';
  const past = !!seva && (mode === 'fixed' || mode === 'range') && !!seva.to && !!today && seva.to < today;
  const closed = !!seva && (seva.status !== 'open' || past);
  const choose = !!seva && seva.amount === 0;
  const unit = seva ? (choose ? Number(amountStr) || 0 : seva.amount) : 0;
  const total = unit * (choose ? 1 : qty);
  const dayName = seva && seva.weekday !== undefined ? WEEKDAYS[locale][seva.weekday] : '';
  const minDate = mode === 'range' && seva?.from && seva.from > today ? seva.from : today;
  const maxDate = mode === 'range' ? seva?.to : undefined;

  const dateHelp = !seva
    ? ''
    : mode === 'fixed'
      ? t.dateFixed.replace('{date}', formatDate(seva.from!, locale))
      : mode === 'range'
        ? t.dateRange.replace('{from}', formatDate(seva.from!, locale)).replace('{to}', formatDate(seva.to!, locale))
        : mode === 'weekday'
          ? t.dateWeekday.replaceAll('{day}', dayName)
          : t.dateAny;

  const clearError = (key: string) =>
    setErrors((e) => {
      if (!e[key]) return e;
      const { [key]: _gone, ...rest } = e;
      return rest;
    });

  const updateMember = (id: number, patch: Partial<FamilyMember>) => {
    setFamily((f) => f.map((m) => (m.uid === id ? { ...m, ...patch } : m)));
    if (patch.name) clearError(`m${id}`);
  };

  function goDate() {
    const e: Record<string, string> = {};
    if (!devotee.trim()) e.devotee = t.errName;
    family.forEach((m) => {
      if (!m.name.trim()) e[`m${m.uid}`] = t.errMember;
    });
    setErrors(e);
    if (Object.keys(e).length === 0) setStep(3);
  }

  function validateDate() {
    if (!seva) return false;
    const e: Record<string, string> = {};
    if (mode !== 'fixed') {
      if (!date) e.date = t.errDate;
      else if (date < today) e.date = t.errDatePast;
      else if (mode === 'range' && (date < (seva.from as string) || date > (seva.to as string))) e.date = t.errDateRange;
      else if (mode === 'weekday' && weekdayOf(date) !== seva.weekday) e.date = t.errDateWeekday.replace('{day}', dayName);
    }
    if (choose && !(Number(amountStr) >= seva.minAmount)) e.amount = t.errAmount.replace('{min}', rupees(seva.minAmount));
    setErrors(e);
    return Object.keys(e).length === 0;
  }

  function addToCart(goToCart: boolean) {
    if (!seva || closed || !validateDate()) return;
    const members: FamilyMember[] = family
      .filter((m) => m.name.trim())
      .map(({ name, relation, rasi: r, nakshatram: n }) => ({ name: name.trim(), relation, rasi: r, nakshatram: n }));
    add({
      slug: seva.slug,
      qty: choose ? 1 : qty,
      unit,
      date,
      devotee: devotee.trim(),
      gotram,
      nakshatram,
      rasi,
      family: members,
    });
    writeSaved({ devotee: devotee.trim(), gotram, rasi, nakshatram, family: members });
    if (goToCart) {
      router.push(`/${locale}/cart`);
      return;
    }
    setAdded(txt(seva.name, locale));
    onChangeSeva?.(); // on the list page this clears the picked seva so the panel returns to step 1
  }

  const stepLabels = [t.stepSeva, t.stepCredentials, t.stepDate];
  const shownStep = added !== null ? 1 : step;
  const title = shownStep === 1 ? t.panelTitleSeva : shownStep === 2 ? t.panelTitleCred : t.panelTitleDate;
  const text = shownStep === 1 ? t.panelTextSeva : shownStep === 2 ? t.panelTextCred : t.panelTextDate;
  const btnPrimary =
    'rounded-md bg-maroon px-5 py-3 text-center font-semibold text-white transition-colors hover:bg-charcoal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron';
  const btnGhost =
    'rounded-md border-2 border-rose bg-white px-5 py-3 text-center font-semibold text-charcoal transition-colors hover:bg-rose focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron';

  return (
    <section aria-labelledby={headingId} className="rounded-2xl bg-white p-6 shadow-lg ring-1 ring-rose">
      <h2
        id={headingId}
        ref={headingRef}
        tabIndex={-1}
        className="font-display text-3xl font-semibold leading-tight text-maroon focus:outline-none [html[lang='ta']_&]:!leading-[1.35] [html[lang='ta']_&]:text-2xl"
      >
        {title}
      </h2>
      <p className="mt-1 text-sm text-charcoal/70">{text}</p>

      {/* Steps */}
      <ol aria-label={t.stepsLabel} className="mt-5 flex items-center gap-2">
        {stepLabels.map((label, i) => {
          const n = i + 1;
          const done = n < shownStep;
          const on = n === shownStep;
          return (
            <li key={label} aria-current={on ? 'step' : undefined} className="flex items-center gap-2">
              <span
                title={label}
                className={`flex h-6 w-6 items-center justify-center rounded-full text-xs font-bold ${
                  done || on ? 'bg-saffron text-charcoal' : 'bg-white text-charcoal/60 ring-1 ring-rose'
                } ${on ? 'ring-2 ring-saffron/40 ring-offset-1' : ''}`}
              >
                {done ? '✓' : n}
              </span>
              <span className="sr-only">{label}</span>
              {i < stepLabels.length - 1 && <span aria-hidden="true" className={`h-0.5 w-10 ${done ? 'bg-saffron' : 'bg-rose'}`} />}
            </li>
          );
        })}
      </ol>

      {/* After adding */}
      {added !== null && (
        <div role="status" className="mt-6 rounded-xl bg-saffron/15 p-5 text-center">
          <p className="font-display text-2xl font-semibold text-maroon">✓ {t.added}</p>
          <p className="mt-1 text-charcoal">{added}</p>
          <div className="mt-4 flex flex-col gap-3">
            <Link href={`/${locale}/cart`} className={btnPrimary}>{t.viewCart}</Link>
            {fixed ? (
              <Link href={`/${locale}/sevas`} className={btnGhost}>{t.keepBrowsing}</Link>
            ) : (
              <button type="button" onClick={() => setAdded(null)} className={btnGhost}>{t.chooseAnother}</button>
            )}
          </div>
        </div>
      )}

      {/* Step 1, nothing picked yet */}
      {added === null && !seva && (
        <p className="mt-6 rounded-xl bg-rose/50 p-5 text-center font-serif text-charcoal/85">{t.panelEmpty}</p>
      )}

      {/* A seva is picked */}
      {added === null && seva && (
        <>
          <div className="mt-5 flex items-start justify-between gap-3 rounded-lg bg-rose/50 p-3">
            <div className="min-w-0">
              <p className="font-semibold leading-snug text-charcoal">{txt(seva.name, locale)}</p>
              <p className="text-sm text-charcoal/75">
                {seva.amount > 0 ? rupees(seva.amount) : t.abilityLabel} · {txt(seva.when, locale)}
              </p>
            </div>
            {!fixed && (
              <button type="button" onClick={onChangeSeva} className="shrink-0 text-sm font-semibold text-maroon underline underline-offset-4 hover:text-charcoal">
                {t.changeSeva}
              </button>
            )}
          </div>

          {closed ? (
            <div className="mt-5 rounded-xl bg-rose/60 p-5 text-center">
              <p className="font-display text-2xl font-semibold text-maroon">{past ? t.statusPast : t.statusClosed}</p>
              <Link href={`/${locale}/sevas`} className="mt-4 inline-block rounded-md bg-maroon px-5 py-2.5 font-semibold text-white hover:bg-charcoal">{t.backLabel}</Link>
            </div>
          ) : step === 2 ? (
            <form
              noValidate
              onSubmit={(e) => {
                e.preventDefault();
                goDate();
              }}
              className="mt-5 space-y-4"
            >
              <div>
                <label htmlFor="kartha" className="block text-sm font-bold text-charcoal">{t.kartha}</label>
                <input
                  id="kartha"
                  value={devotee}
                  onChange={(e) => {
                    setDevotee(e.target.value);
                    if (e.target.value.trim()) clearError('devotee');
                  }}
                  autoComplete="off"
                  aria-invalid={!!errors.devotee}
                  aria-describedby={errors.devotee ? 'kartha-error' : 'kartha-hint'}
                  className={`${fieldClass} mt-1`}
                />
                {errors.devotee ? (
                  <p id="kartha-error" role="alert" className="mt-1 text-sm font-semibold text-maroon">{errors.devotee}</p>
                ) : (
                  <p id="kartha-hint" className="mt-1 text-sm text-charcoal/70">{t.devoteeNameHelp}</p>
                )}
              </div>

              <ChoiceField id="gotram" label={t.gotramFull} value={gotram} onChange={setGotram} options={GOTRAMS} locale={locale}
                placeholder={t.choose} otherLabel={t.otherOption} typeLabel={t.typeManually} />
              <div className={`grid gap-4 ${fixed ? 'sm:grid-cols-2' : ''}`}>
                <ChoiceField id="rasi" label={t.rasiFull} value={rasi} onChange={setRasi} options={RASIS} locale={locale}
                  placeholder={t.choose} otherLabel={t.otherOption} typeLabel={t.typeManually} />
                <ChoiceField id="nakshatram" label={t.nakshatramFull} value={nakshatram} onChange={setNakshatram} options={NAKSHATRAMS} locale={locale}
                  placeholder={t.choose} otherLabel={t.otherOption} typeLabel={t.typeManually} />
              </div>
              <p className="text-sm text-charcoal/70">{t.optionalNote}</p>

              {/* Family members */}
              {family.map((m, i) => (
                <fieldset key={m.uid} className="rounded-xl border border-rose p-4">
                  <legend className="px-1 text-sm font-bold text-maroon">{t.familyTitle.replace('{n}', String(i + 1))}</legend>
                  <div className="space-y-3">
                    <div>
                      <label htmlFor={`m${m.uid}-name`} className="block text-sm font-bold text-charcoal">{t.memberName}</label>
                      <input
                        id={`m${m.uid}-name`}
                        value={m.name}
                        onChange={(e) => updateMember(m.uid, { name: e.target.value })}
                        autoComplete="off"
                        aria-invalid={!!errors[`m${m.uid}`]}
                        aria-describedby={errors[`m${m.uid}`] ? `m${m.uid}-error` : undefined}
                        className={`${fieldClass} mt-1`}
                      />
                      {errors[`m${m.uid}`] && <p id={`m${m.uid}-error`} role="alert" className="mt-1 text-sm font-semibold text-maroon">{errors[`m${m.uid}`]}</p>}
                    </div>
                    <ChoiceField id={`m${m.uid}-relation`} label={t.relation} value={m.relation} onChange={(v) => updateMember(m.uid, { relation: v })} options={RELATIONS} locale={locale}
                      placeholder={t.choose} otherLabel={t.otherOption} typeLabel={t.typeManually} />
                    <div className={`grid gap-3 ${fixed ? 'sm:grid-cols-2' : ''}`}>
                      <ChoiceField id={`m${m.uid}-rasi`} label={t.rasiFull} value={m.rasi} onChange={(v) => updateMember(m.uid, { rasi: v })} options={RASIS} locale={locale}
                        placeholder={t.choose} otherLabel={t.otherOption} typeLabel={t.typeManually} />
                      <ChoiceField id={`m${m.uid}-nakshatram`} label={t.nakshatramFull} value={m.nakshatram} onChange={(v) => updateMember(m.uid, { nakshatram: v })} options={NAKSHATRAMS} locale={locale}
                        placeholder={t.choose} otherLabel={t.otherOption} typeLabel={t.typeManually} />
                    </div>
                    <button type="button" onClick={() => setFamily((f) => f.filter((x) => x.uid !== m.uid))} className="text-sm font-semibold text-maroon underline underline-offset-4 hover:text-charcoal">
                      {t.removeMember}
                    </button>
                  </div>
                </fieldset>
              ))}

              {family.length < MAX_FAMILY ? (
                <button
                  type="button"
                  onClick={() => setFamily((f) => [...f, { uid: ++uid.current, name: '', relation: '', rasi: '', nakshatram: '' }])}
                  className="inline-flex items-center gap-2 text-sm font-bold text-maroon hover:text-charcoal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron"
                >
                  <span aria-hidden="true" className="flex h-5 w-5 items-center justify-center rounded-full border-2 border-maroon text-sm leading-none">+</span>
                  {t.addFamily}
                </button>
              ) : (
                <p className="text-sm text-charcoal/70">{t.maxFamily.replace('{n}', String(MAX_FAMILY))}</p>
              )}
              {family.length > 0 && <p className="text-sm text-charcoal/70">{t.familyHelp}</p>}

              <div className={`grid gap-3 pt-2 ${fixed ? '' : 'sm:grid-cols-2'}`}>
                {!fixed && (
                  <button type="button" onClick={onChangeSeva} className={btnGhost}>{t.back}</button>
                )}
                <button type="submit" className={btnPrimary}>{t.nextDate}</button>
              </div>
            </form>
          ) : (
            <form
              noValidate
              onSubmit={(e) => {
                e.preventDefault();
                addToCart(false);
              }}
              className="mt-5 space-y-4"
            >
              <div>
                <label htmlFor="seva-date" className="block text-sm font-bold text-charcoal">{t.dateLabel}</label>
                {mode === 'fixed' ? (
                  <p id="seva-date" className="mt-1 rounded-md bg-rose/50 px-4 py-2.5 font-semibold text-charcoal">{formatDate(seva.from!, locale)}</p>
                ) : (
                  <input
                    id="seva-date"
                    type="date"
                    value={date}
                    min={minDate || undefined}
                    max={maxDate}
                    onChange={(e) => {
                      setDate(e.target.value);
                      clearError('date');
                    }}
                    aria-invalid={!!errors.date}
                    aria-describedby={errors.date ? 'seva-date-error' : 'seva-date-hint'}
                    className={`${fieldClass} mt-1`}
                  />
                )}
                {errors.date ? (
                  <p id="seva-date-error" role="alert" className="mt-1 text-sm font-semibold text-maroon">{errors.date}</p>
                ) : (
                  <p id="seva-date-hint" className="mt-1 text-sm text-charcoal/70">{dateHelp}</p>
                )}
              </div>
              {seva.note && <p className="rounded-md bg-saffron/15 px-4 py-2 text-sm font-semibold text-charcoal">{txt(seva.note, locale)}</p>}

              {choose ? (
                <div>
                  <label htmlFor="amount" className="block text-sm font-bold text-charcoal">{t.amountInput}</label>
                  <div className="relative mt-1">
                    <span aria-hidden="true" className="absolute left-4 top-1/2 -translate-y-1/2 font-bold text-charcoal/70">₹</span>
                    <input
                      id="amount"
                      inputMode="numeric"
                      value={amountStr}
                      onChange={(e) => setAmountStr(e.target.value.replace(/\D/g, ''))}
                      aria-invalid={!!errors.amount}
                      aria-describedby={errors.amount ? 'amount-error' : 'amount-hint'}
                      className={`${fieldClass} pl-9`}
                    />
                  </div>
                  {errors.amount ? (
                    <p id="amount-error" role="alert" className="mt-1 text-sm font-semibold text-maroon">{errors.amount}</p>
                  ) : (
                    <p id="amount-hint" className="mt-1 text-sm text-charcoal/70">{t.amountHelp}</p>
                  )}
                </div>
              ) : (
                <div>
                  <p className="text-sm font-bold text-charcoal">{t.qtyLabel}</p>
                  <div className="mt-1 inline-flex items-center rounded-md border-2 border-rose">
                    <button type="button" aria-label={t.decrease} disabled={qty <= 1} onClick={() => setQty((q) => Math.max(1, q - 1))} className="h-11 w-11 text-xl font-bold text-maroon hover:bg-rose disabled:opacity-40">−</button>
                    <span aria-live="polite" className="w-12 text-center text-lg font-bold">{qty}</span>
                    <button type="button" aria-label={t.increase} disabled={qty >= seva.maxQty} onClick={() => setQty((q) => Math.min(seva.maxQty, q + 1))} className="h-11 w-11 text-xl font-bold text-maroon hover:bg-rose disabled:opacity-40">+</button>
                  </div>
                </div>
              )}

              <p className="flex items-baseline justify-between border-t border-rose pt-4">
                <span className="font-semibold text-charcoal/80">{t.totalLabel}</span>
                <span className="font-display text-3xl font-semibold text-maroon">{rupees(total)}</span>
              </p>

              <div className="grid gap-3">
                <button type="submit" className={btnPrimary}>{t.addToSevaCart}</button>
                <button type="button" onClick={() => addToCart(true)} className={btnGhost}>{t.addAndGo}</button>
                <button type="button" onClick={() => setStep(2)} className="text-sm font-semibold text-maroon underline underline-offset-4 hover:text-charcoal">{t.back}</button>
              </div>
            </form>
          )}
        </>
      )}
    </section>
  );
}
