import type { Dictionary } from '@/lib/dictionary';
import Reveal from './Reveal';
import SectionTitle from './SectionTitle';

// Photos: apps/web/public/images/acharya-1.jpg, acharya-2.jpg, acharya-3.jpg (portrait, about 600x750).
// Until they exist, a palette gradient shows instead.
const FALLBACK = 'linear-gradient(180deg, #F3E4E1 0%, #7A1C1C 100%)';

export default function Acharyas({ t }: { t: Dictionary['acharyas'] }) {
  return (
    <section aria-labelledby="acharyas-title" className="bg-white py-16 sm:py-24">
      <div className="mx-auto max-w-7xl px-4 lg:px-8">
        <SectionTitle id="acharyas-title" title={t.title} subtitle={t.subtitle} />
        <div className="mt-14 grid gap-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
          {t.items.map((a, n) => (
            <Reveal key={a.name} delay={n * 120} className="sm:last:col-span-2 sm:last:mx-auto sm:last:max-w-sm lg:last:col-span-1 lg:last:max-w-none">
              <article className="group text-center">
                <div className="relative mx-auto w-44 sm:w-52">
                  <div aria-hidden="true" className="absolute -inset-2.5 rounded-t-[9999px] rounded-b-2xl border border-saffron/60 transition-all duration-500 group-hover:-inset-3.5 group-hover:border-saffron" />
                  <div role="img" aria-label={a.name}
                    className="relative aspect-[4/5] rounded-b-xl rounded-t-[9999px] border-[3px] border-saffron bg-cover bg-top shadow-lg"
                    style={{ backgroundImage: `url('/images/acharya-${n + 1}.jpg'), ${FALLBACK}` }} />
                </div>
                <h3 className="mt-8 text-2xl">{a.name}</h3>
                <p className="mt-1 text-sm font-semibold uppercase tracking-wide text-charcoal/70">{a.role}</p>
                <p className="mx-auto mt-3 max-w-xs text-charcoal/85">{a.text}</p>
              </article>
            </Reveal>
          ))}
        </div>
      </div>
    </section>
  );
}
