'use client';

import Link from 'next/link';
import type { Dictionary } from '@/lib/dictionary';
import type { Locale } from '@/lib/i18n';
import { formatDate, rupees, sevaPhoto } from '@/lib/format';
import { getSeva, txt } from '@/data/sevas';
import { useCart } from './CartProvider';

export default function CartView({ t, locale }: { t: Dictionary['shop']; locale: Locale }) {
  const { ready, lines, count, total, setQty, remove } = useCart();
  const href = (p: string) => `/${locale}${p}`;

  if (!ready) return <p role="status" className="py-16 text-center text-charcoal/70">{t.loading}</p>;

  if (lines.length === 0) {
    return (
      <div className="mx-auto max-w-xl rounded-2xl bg-rose/50 px-6 py-14 text-center">
        <p className="font-display text-3xl font-semibold text-maroon">{t.cartEmpty}</p>
        <p className="mt-2 font-serif text-lg text-charcoal/90">{t.cartEmptyText}</p>
        <Link href={href('/sevas')} className="mt-6 inline-block rounded-md bg-maroon px-7 py-3 font-semibold text-white hover:bg-charcoal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron">{t.browse}</Link>
      </div>
    );
  }

  return (
    <div className="grid items-start gap-8 lg:grid-cols-[1fr_360px]">
      <ul className="space-y-4">
        {lines.map((l) => {
          const seva = getSeva(l.slug);
          const name = seva ? txt(seva.name, locale) : l.slug;
          const fixedPrice = seva ? seva.amount > 0 : false;
          const max = seva?.maxQty ?? 10;
          return (
            <li key={l.id} className="flex flex-col gap-4 rounded-2xl bg-white p-4 shadow-md ring-1 ring-rose sm:flex-row sm:p-5">
              <div role="img" aria-label={name} className="h-32 w-full shrink-0 rounded-xl bg-maroon bg-cover bg-center sm:h-28 sm:w-36" style={{ backgroundImage: sevaPhoto(l.slug) }} />
              <div className="flex min-w-0 flex-1 flex-col">
                <h2 className="font-display text-2xl font-semibold leading-tight text-maroon [html[lang='ta']_&]:!leading-[1.4] [html[lang='ta']_&]:text-xl">
                  <Link href={href(`/sevas/${l.slug}`)} className="hover:underline">{name}</Link>
                </h2>
                <dl className="mt-2 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
                  <div className="flex gap-2"><dt className="font-bold text-charcoal/70">{t.dateLabel}:</dt><dd>{formatDate(l.date, locale)}</dd></div>
                  <div className="flex gap-2"><dt className="font-bold text-charcoal/70">{t.devoteeLabel}:</dt><dd>{l.devotee}</dd></div>
                  {l.gotram && <div className="flex gap-2"><dt className="font-bold text-charcoal/70">{t.gotramLabel}:</dt><dd>{l.gotram}</dd></div>}
                  {l.nakshatram && <div className="flex gap-2"><dt className="font-bold text-charcoal/70">{t.nakshatramLabel}:</dt><dd>{l.nakshatram}</dd></div>}
                </dl>

                <div className="mt-4 flex flex-wrap items-center justify-between gap-3">
                  {fixedPrice ? (
                    <div className="inline-flex items-center rounded-md border-2 border-rose" role="group" aria-label={t.qtyLabel}>
                      <button type="button" aria-label={t.decrease} disabled={l.qty <= 1} onClick={() => setQty(l.id, l.qty - 1)} className="h-10 w-10 text-xl font-bold text-maroon hover:bg-rose disabled:opacity-40">−</button>
                      <span aria-live="polite" className="w-10 text-center font-bold">{l.qty}</span>
                      <button type="button" aria-label={t.increase} disabled={l.qty >= max} onClick={() => setQty(l.id, l.qty + 1)} className="h-10 w-10 text-xl font-bold text-maroon hover:bg-rose disabled:opacity-40">+</button>
                    </div>
                  ) : (
                    <span className="text-sm text-charcoal/70">{t.yourAmount}</span>
                  )}
                  <p className="font-display text-3xl font-semibold text-charcoal">{rupees(l.qty * l.unit)}</p>
                </div>
                <button type="button" onClick={() => remove(l.id)} className="mt-3 self-start text-sm font-semibold text-maroon underline underline-offset-4 hover:text-charcoal focus-visible:outline focus-visible:outline-2 focus-visible:outline-saffron">{t.remove}</button>
              </div>
            </li>
          );
        })}
      </ul>

      <aside aria-label={t.summaryTitle} className="rounded-2xl bg-white p-6 shadow-lg ring-2 ring-rose lg:sticky lg:top-24">
        <h2 className="font-display text-2xl font-semibold text-maroon [html[lang='ta']_&]:!leading-[1.4]">{t.summaryTitle}</h2>
        <dl className="mt-4 space-y-2">
          <div className="flex justify-between"><dt className="text-charcoal/80">{t.itemsLabel}</dt><dd className="font-semibold">{count}</dd></div>
          <div className="flex items-baseline justify-between border-t-2 border-rose pt-4">
            <dt className="font-bold">{t.total}</dt>
            <dd className="font-display text-3xl font-semibold text-maroon">{rupees(total)}</dd>
          </div>
        </dl>
        <Link href={href('/checkout')} className="mt-6 block rounded-md bg-maroon px-5 py-3 text-center font-semibold text-white transition-colors hover:bg-charcoal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron">{t.checkoutCta}</Link>
        <Link href={href('/sevas')} className="mt-3 block text-center text-sm font-semibold text-maroon underline underline-offset-4">{t.continueShopping}</Link>
        <p className="mt-4 text-center text-xs text-charcoal/70">{t.receiptNote}</p>
      </aside>
    </div>
  );
}
