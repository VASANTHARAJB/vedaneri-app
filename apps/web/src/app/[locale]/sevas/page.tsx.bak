import type { Metadata } from 'next';
import Link from 'next/link';
import { notFound } from 'next/navigation';
import Reveal from '@/components/Reveal';
import SevaList from '@/components/SevaList';
import { getDictionary } from '@/lib/dictionary';
import { isLocale } from '@/lib/i18n';

type Params = { params: Promise<{ locale: string }> };

export async function generateMetadata({ params }: Params): Promise<Metadata> {
  const { locale } = await params;
  if (!isLocale(locale)) return {};
  const t = getDictionary(locale);
  return {
    title: `${t.sevas.meta.title} | ${t.site.name}`,
    description: t.sevas.meta.description,
  };
}

function Flame({ className = '' }: { className?: string }) {
  return (
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" className={`shrink-0 ${className}`}>
      <path d="M12 2c.6 3.2 4.5 5.4 4.5 10a4.5 4.5 0 0 1-9 0c0-2 .9-3.2 1.8-4.4.4 1.2 1 1.8 1.7 2C11.3 7.7 11.6 5 12 2z" />
    </svg>
  );
}

function Arrow() {
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" className="transition-transform duration-300 group-hover:translate-x-1.5">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  );
}

function Mandala({ className = '' }: { className?: string }) {
  return (
    <svg aria-hidden="true" viewBox="0 0 200 200" className={className} fill="none" stroke="currentColor" strokeWidth="1.2">
      {[0, 30, 60, 90, 120, 150].map((d) => (
        <ellipse key={d} cx="100" cy="100" rx="22" ry="80" transform={`rotate(${d} 100 100)`} />
      ))}
      <circle cx="100" cy="100" r="80" />
      <circle cx="100" cy="100" r="30" />
    </svg>
  );
}

export default async function SevasPage({ params }: Params) {
  const { locale } = await params;
  if (!isLocale(locale)) notFound();
  const dict = getDictionary(locale);
  const t = dict.sevas;
  const href = (p: string) => `/${locale}${p}`;

  return (
    <main>
      {/* 1. Hero */}
      <section aria-labelledby="sevas-title" className="relative isolate overflow-hidden bg-gradient-to-b from-rose/80 via-white to-white">
        <Mandala className="absolute -right-40 -top-40 -z-10 h-[36rem] w-[36rem] text-maroon/[0.06]" />
        <Mandala className="absolute -bottom-52 -left-40 -z-10 h-[30rem] w-[30rem] text-saffron/[0.12]" />

        <nav aria-label={t.crumbLabel} className="mx-auto max-w-6xl px-4 pt-6 text-sm text-charcoal/80 lg:px-8">
          <ol className="flex flex-wrap items-center gap-2">
            <li><Link href={href('')} className="underline-offset-4 hover:text-maroon hover:underline">{dict.nav.home}</Link></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" className="font-semibold text-maroon">{dict.nav.seva}</li>
          </ol>
        </nav>

        <div className="mx-auto max-w-3xl px-4 pb-14 pt-10 text-center sm:pb-16">
          <p className="inline-flex items-center gap-2 rounded-full border border-saffron bg-white px-4 py-1.5 text-sm font-semibold text-maroon sm:text-base">
            <Flame className="text-saffron" />
            <span>{t.eyebrow}</span>
          </p>
          <h1 id="sevas-title" className="animate-fade-up mt-5 font-display text-5xl font-semibold leading-[1.1] text-maroon motion-reduce:animate-none sm:text-6xl [html[lang='ta']_&]:!leading-[1.3] [html[lang='ta']_&]:text-4xl [html[lang='ta']_&]:sm:text-5xl">{t.title}</h1>
          <div aria-hidden="true" className="mt-4 flex items-center justify-center gap-3">
            <span className="h-px w-14 bg-saffron" />
            <span className="h-2 w-2 rotate-45 bg-saffron" />
            <span className="h-px w-14 bg-saffron" />
          </div>
          <p className="mx-auto mt-5 max-w-2xl font-serif text-lg leading-relaxed text-charcoal/90 sm:text-xl">{t.intro}</p>

          <div className="mt-8 flex flex-wrap justify-center gap-3">
            <a href="#seva-list" className="inline-flex items-center rounded-full bg-maroon px-6 py-2.5 font-semibold text-white transition-colors hover:bg-charcoal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron">{t.listLabel}</a>
            <Link href={href('/donate')} className="inline-flex items-center rounded-full border-2 border-saffron bg-white px-6 py-2.5 font-semibold text-maroon transition-colors hover:bg-rose focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron">{t.corpusLabel}</Link>
          </div>
        </div>
      </section>

      {/* 2. Seva list */}
      <section aria-label={t.listLabel} className="bg-white pb-16 pt-6 sm:pb-20">
        <div className="mx-auto max-w-6xl px-4 lg:px-8">
          <SevaList t={t} locale={locale} />
        </div>
      </section>

      {/* 3. Corpus fund */}
      <section aria-labelledby="corpus-title" className="relative isolate overflow-hidden bg-maroon py-14 text-white sm:py-16">
        <Mandala className="absolute -right-32 -top-32 -z-10 h-[30rem] w-[30rem] text-white/[0.06]" />
        <Reveal>
          <div className="mx-auto max-w-3xl px-4 text-center lg:px-8">
            <h2 id="corpus-title" className="font-display text-4xl font-semibold leading-tight !text-white sm:text-5xl [html[lang='ta']_&]:!leading-[1.3]">{t.corpusTitle}</h2>
            <div aria-hidden="true" className="mt-4 flex items-center justify-center gap-3">
              <span className="h-px w-12 bg-saffron" />
              <Flame className="text-saffron" />
              <span className="h-px w-12 bg-saffron" />
            </div>
            <p className="mt-6 font-serif text-lg leading-relaxed text-white/90">{t.corpusText}</p>
            <Link
              href={href('/donate')}
              className="group mt-8 inline-flex items-center gap-2 rounded-md bg-saffron px-7 py-3 font-semibold text-charcoal transition-colors hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-saffron"
            >
              {t.corpusCta}
              <Arrow />
            </Link>
          </div>
        </Reveal>
      </section>

      {/* 4. Help */}
      <section aria-labelledby="help-title" className="bg-saffron py-10 text-charcoal sm:py-12">
        <div className="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 text-center lg:flex-row lg:justify-between lg:px-8 lg:text-left">
          <div className="max-w-2xl">
            <h2 id="help-title" className="font-display text-3xl font-semibold leading-tight !text-charcoal sm:text-4xl">{t.helpTitle}</h2>
            <p className="mt-2 text-lg">{t.helpText}</p>
          </div>
          <Link
            href={href('/contact')}
            className="group inline-flex items-center gap-2 rounded-md bg-charcoal px-7 py-3 font-semibold text-white transition-colors hover:bg-maroon focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-charcoal"
          >
            {t.helpCta}
            <Arrow />
          </Link>
        </div>
      </section>
    </main>
  );
}