export default async function Page({ params }: { params: Promise<{ locale: string }> }) {
  const { locale } = await params;
  return (
    <main className="p-8">
      <h1 className="font-serif text-2xl text-maroon">donate</h1>
      <p className="mt-2">Placeholder ({locale}). Built in its own step.</p>
    </main>
  );
}
